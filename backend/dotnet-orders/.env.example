# orders · copiar a .env para desarrollo local (en el servidor van en /etc/entradasya/orders.env)
HOST=0.0.0.0
PORT=4003
LOG_LEVEL=info

# Base de datos propia (formato URL; el servicio lo convierte para Npgsql)
DATABASE_URL=postgresql://orders_user:orders_pass@localhost:5433/orders_db

# Mismos valores en todos los servicios
JWT_SECRET=dev-jwt-secret-entradasya-0123456789abcdef
JWT_ISSUER=entradasya-auth
INTERNAL_API_TOKEN=dev-internal-token-entradasya

# Servicios a los que llama orders y tiempo máximo de espera por llamada
EVENTS_URL=http://localhost:4002
PAYMENTS_URL=http://localhost:4004
TICKETS_URL=http://localhost:4005
NOTIFICATIONS_URL=http://localhost:4006
HTTP_TIMEOUT_MS=5000
