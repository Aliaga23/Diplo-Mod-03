# Copiar como .env y ajustar. Nunca versionar .env.
HOST=0.0.0.0
PORT=4001
LOG_LEVEL=info
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5433/auth_db

# Deben ser iguales en todos los servicios que validan tokens
JWT_SECRET=dev-jwt-secret-entradasya-0123456789abcdef
JWT_ISSUER=entradasya-auth
JWT_EXPIRES_IN=2h

# Solo para pnpm db:seed (cuentas de organizador y portero de demostración)
SEED_ORGANIZER_PASSWORD=Demo12345!
SEED_PORTER_PASSWORD=Demo12345!
