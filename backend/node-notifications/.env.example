# Copiar como .env y ajustar. Nunca versionar .env.
# Servicio interno: escucha solo en 127.0.0.1
HOST=127.0.0.1
PORT=4006
LOG_LEVEL=info

# Debe ser igual en orders (quien llama a este servicio)
INTERNAL_API_TOKEN=dev-internal-token-entradasya

# Mailpit (correo de prueba)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TIMEOUT_MS=5000
MAIL_FROM="EntradasYa <no-reply@entradasya.local>"

# Enlace del correo a "Mis entradas"
WEB_BASE_URL=http://localhost:5173
