# Copiar a .env y ajustar. En el servidor estas variables vienen de /etc/entradasya/events.env
HOST=0.0.0.0
PORT=4002
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://events_user:events_pass@localhost:5433/events_db
# Mismo valor en todos los servicios
JWT_SECRET=dev-jwt-secret-entradasya-0123456789abcdef
JWT_ISSUER=entradasya-auth
INTERNAL_API_TOKEN=dev-internal-token-entradasya
