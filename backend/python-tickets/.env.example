# Copiar a .env y ajustar. En el servidor estas variables vienen de /etc/entradasya/tickets.env
HOST=0.0.0.0
PORT=4005
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://tickets_user:tickets_pass@localhost:5433/tickets_db
# Carpeta local donde se guardan los PDF (en el servidor: /var/lib/entradasya/tickets)
TICKETS_DIR=./storage/tickets
# Zona horaria con la que se imprime la fecha del evento en el PDF
DISPLAY_TIMEZONE=America/La_Paz
# Mismo valor en todos los servicios
JWT_SECRET=dev-jwt-secret-entradasya-0123456789abcdef
JWT_ISSUER=entradasya-auth
INTERNAL_API_TOKEN=dev-internal-token-entradasya
