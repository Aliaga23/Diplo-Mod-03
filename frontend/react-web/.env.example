# EntradasYa · web (React + Vite)
# Copia este archivo como .env (no se versiona).

# Moneda para mostrar precios (código ISO 4217). Se incrusta en el build.
VITE_CURRENCY=BOB

# --- Solo desarrollo (pnpm dev) ---
# Puerto del servidor de desarrollo.
WEB_DEV_PORT=5173
# Destinos del proxy de Vite. Replican las rutas /api/<servicio>/ de Nginx.
AUTH_URL=http://localhost:4001
EVENTS_URL=http://localhost:4002
ORDERS_URL=http://localhost:4003
TICKETS_URL=http://localhost:4005
CHECKIN_URL=http://localhost:4007
