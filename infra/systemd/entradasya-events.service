# EntradasYa · servicio events (Python)
# Instalar: sudo cp infra/systemd/entradasya-events.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now entradasya-events
[Unit]
Description=EntradasYa events (Python)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=entradasya
Group=entradasya
WorkingDirectory=/opt/entradasya/events
# Toda la configuración viene de aquí (puertos, BD, secretos). No se versiona.
EnvironmentFile=/etc/entradasya/events.env
ExecStart=/opt/entradasya/events/.venv/bin/python -m app
Restart=on-failure
RestartSec=3
# Los logs van a la consola → journald:  journalctl -u entradasya-events -f
StandardOutput=journal
StandardError=journal

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
